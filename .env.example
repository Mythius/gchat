# ── notify_chat.py (Webhook — Google Workspace only) ─────────────────────────
# Get from: Google Chat > space name > Apps & integrations > Add webhook
GOOGLE_CHAT_WEBHOOK_URL=

# ── notify_chat_sa.py (Service account — personal or Workspace) ───────────────
# Find in the Chat URL: chat.google.com/room/SPACE_ID/...
GOOGLE_CHAT_SPACE_ID=

# ── discord.py (Webhook — personal or server) ────────────────────────────────
# Get from: Channel Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=
